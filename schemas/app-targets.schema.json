{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vesper.example/schemas/app-targets.schema.json",
  "title": "Signed application targets",
  "type": "object",
  "required": [
    "signed",
    "signatures"
  ],
  "properties": {
    "signed": {
      "type": "object",
      "required": [
        "_type",
        "spec_version",
        "version",
        "expires",
        "channels",
        "sources",
        "metadata"
      ],
      "properties": {
        "_type": {
          "const": "targets"
        },
        "spec_version": {
          "const": "1.0.0"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "expires": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "minItems": 1
        },
        "metadata": {
          "type": "object",
          "required": [
            "store.json",
            "description.md"
          ],
          "additionalProperties": false,
          "properties": {
            "store.json": {
              "$ref": "#/$defs/storeFile"
            },
            "description.md": {
              "$ref": "#/$defs/storeFile"
            }
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1
    }
  },
  "$defs": {
    "storeFile": {
      "type": "object",
      "required": [
        "length",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}
